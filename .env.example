# Aevion Studio — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local with real secrets into Git.

# Database (PostgreSQL) - Required for Vercel production deployment.
# In local development without DATABASE_URL, Aevion automatically falls back to .data/aevion_store.json.
DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/aevion?sslmode=require"

# Application URL
APP_URL="https://aevionstudio.in"

# One-time bootstrap secret token for initial owner creation
BOOTSTRAP_SECRET="generate-a-cryptographically-secure-random-token-here"

# Groq AI Assistant Key
GROQ_API_KEY=""

# WhatsApp Destination Number (with country code, e.g., 917604904217)
NEXT_PUBLIC_WHATSAPP_NUMBER="917604904217"
